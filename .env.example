APP_NAME="School Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Untuk demo cepat bisa pakai SQLite (tidak perlu install MySQL).
# Ganti ke mysql kalau mengikuti guideline project (Migration & Seeder di MySQL).
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=school_care
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=public

CACHE_STORE=database
QUEUE_CONNECTION=database
